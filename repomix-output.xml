        padding: 68px 20px
    }

    .section-heading {
        display: block
    }

    .section-heading h2 {
        font-size: 43px
    }

    .inventory-caption {
        text-align: left;
        margin-top: 18px
    }

    .product-grid {
        grid-template-columns: repeat(2, 1fr);
