    padding-bottom: 5px;
    font-size: 11px
}

.contact-links span {
    margin-right: 8px
}

.site-footer {
    background: var(--brown);
    color: #f8eee3;
    padding: 50px max(40px, calc((100vw - 1160px)/2)) 25px
}

.brand.light {
    color: #fff8ef
}

.brand.light em {
    color: #e79b7e
}

.footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 50px
}

.footer-top p {
