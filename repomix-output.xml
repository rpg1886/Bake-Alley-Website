}

.contact-copy p {
    font: 18px/1.35 Fraunces, serif
}

.contact-links {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 30px
}

.contact-links a {
    color: #fff8ef;
