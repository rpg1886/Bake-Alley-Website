/* Pagination & Chat Reserve Styling */
.pagination-container {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 35px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
}

.pagination-tabs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
}

.page-tab {
    background: var(--paper);
    border: 1px solid var(--line);
    color: var(--brown);
    font: 600 13px 'DM Sans', sans-serif;
    padding: 8px 14px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.page-tab:hover:not(.disabled) {
    background: var(--oat);
    border-color: var(--brown);
