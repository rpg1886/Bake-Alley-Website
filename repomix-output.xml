    }

    .header-action {
        font-size: 11px
    }

    .hero {
        display: block;
        padding: 45px 20px 60px
    }

    .hero-copy {
        margin-bottom: 42px
    }

    .hero-art {
        height: 330px
    }

    .story-strip {
        display: block;
        padding: 60px 20px
